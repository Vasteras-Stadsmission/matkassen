#!/bin/sh
set -e

staged=$(git diff --cached --name-only --diff-filter=d -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.scss' '*.md' '*.yml' '*.yaml')
# Skip partially staged files: adding them back would also stage their
# unstaged changes. The pre-push format check still covers them.
files=$(echo "$staged" | grep -vxF "$(git diff --name-only)" || true)
[ -z "$files" ] && exit 0

echo "$files" | xargs pnpm exec prettier --write --ignore-unknown
echo "$files" | xargs git add
